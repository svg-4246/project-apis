#%RAML 1.0
title: z-experience-api

types:
  employeeDetails: !include dataTypes/dataType.raml
/employeedetails:
  get:
    queryParameters:
      employeeid:
        type: integer
    responses:
      200:
        body:
          application/json:
            example: !include examples/schema.json
      400:
        body:
          application/json:
            example:
              {
                "message": "recod not found"
              }
  post:
    body:
      application/json:
        type: employeeDetails
        example: !includeexamples/
    responses:
      201:
        body:
          application/json:
            example:
              {
                "message": "created"
              }
      400:
        body:
          application/json:
            example:
              {
                "message": "not created"
              }
          
              